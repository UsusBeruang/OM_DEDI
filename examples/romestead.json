{
  "id": "romestead",
  "name": "Romestead",
  "process": {
    "executable": "dotnet",
    "workingDirectory": "E:\\_servers_\\Romestead",
    "arguments": "Server.dll",
    "createNoWindow": false,
    "removeEnvironmentVariables": [
      "DOTNET_TieredCompilation",
      "DOTNET_ROOT_X64"
    ]
  },
  "transport": {
    "type": "stdin"
  },
  "stopCommand": "stop",
  "shutdownTimeoutSeconds": 20,
  "commands": {
    "players": "list",
    "save": "save",
    "quicksave": "quicksave",
    "say": "say {args}",
    "kick": "kick {args}",
    "ban": "ban {args}",
    "unban": "unban {args}"
  },
  "commandCaptures": {
    "players": {
      "timeoutMs": 2500,
      "quietPeriodMs": 400,
      "includeStandardError": false
    }
  }
}
