{
  "id": "romestead",
  "name": "Romestead",
  "process": {
    "executable": "E:\\_servers_\\Romestead\\Server.exe",
    "workingDirectory": "E:\\_servers_\\Romestead",
    "arguments": "",
    "mode": "pty",
    "terminalColumns": 120,
    "terminalRows": 30
  },
  "transport": {
    "type": "stdin"
  },
  "stopCommand": "stop",
  "shutdownTimeoutSeconds": 20,
  "commands": {
    "players": "list",
    "save": "save",
    "quicksave": "quicksave",
    "say": "say {args}",
    "kick": "kick {args}",
    "ban": "ban {args}",
    "unban": "unban {args}"
  },
  "commandCaptures": {
    "players": {
      "timeoutMs": 2500,
      "quietPeriodMs": 400,
      "includeStandardError": false
    }
  }
}
